# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (recommended). The legacy anon key works too:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OAuth — sign access tokens for "Sign in with Yavqo Account".
# Any long random string, e.g. `openssl rand -hex 32`.
OAUTH_JWT_SECRET=

# Public origin of this app (used as the OAuth token issuer).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — card verification on the wallet page.
# Dashboard → Developers → API keys (test mode keys work fine).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
