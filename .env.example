# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (recommended). The legacy anon key works too:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OAuth — sign access tokens for "Sign in with Yavqo Account".
# Any long random string, e.g. `openssl rand -hex 32`.
OAUTH_JWT_SECRET=

# Public origin of this app (used as the OAuth token issuer).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Mapbox token for saved-address suggestions. This value is sent to the browser.
MAPBOX_PUBLIC_TOKEN=

# Server-only Google Cloud Translation Basic API key. Enable billing and the
# Cloud Translation API in Google Cloud before setting this value.
GOOGLE_TRANSLATE_API_KEY=

# Resend API key. Verify emails.yavqo.com as a sending domain in Resend.
RESEND_API_KEY=

# OAuth passkey verification uses Supabase Auth Passkeys (beta). Enable it in
# Authentication → Passkeys for the deployed origin and set the matching RP ID.
# The SQL in supabase/oauth_passkey_stepup.sql and
# supabase/oauth_passkey_issue_code.sql must be applied before deployment.

# Stripe — card verification on the wallet page.
# Dashboard → Developers → API keys (test mode keys work fine).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
